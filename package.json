{
  "name": "speechify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite ui --host 127.0.0.1",
    "build": "tsc --noEmit -p ui && vite build ui",
    "test": "vitest run --root ui",
    "test:coverage": "vitest run --root ui --coverage",
    "tauri": "tauri",
    "format": "prettier --write ui",
    "format:check": "prettier --check ui"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.6.5",
    "@tauri-apps/cli": "2.12.4",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
