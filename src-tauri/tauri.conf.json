{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speechify",
  "identifier": "org.sumedhbhat.speechify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Speechify",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "center": true
      },
      {
        "label": "bar",
        "title": "Speechify bar",
        "url": "bar.html",
        "width": 220,
        "height": 48,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/native/**/*"],
    "category": "Productivity",
    "shortDescription": "Local voice dictation",
    "longDescription": "Hold a shortcut, speak, and clean text is typed into any app. Runs open-source models on your own machine.",
    "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist", "infoPlist": "Info.plist" },
    "linux": { "deb": { "depends": ["libasound2t64"] } }
  }
}
