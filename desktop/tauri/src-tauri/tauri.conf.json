{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speechify Tauri Candidate",
  "version": "0.1.0",
  "identifier": "org.sumedhbhat.speechify.tauri",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Speechify Tauri Candidate",
        "width": 1060,
        "height": 740,
        "minWidth": 520,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "resources": [
      "resources/native/**/*",
      "resources/exception-worker.py",
      "resources/training/**/*",
      "resources/requirements/*",
      "resources/exception-models.json"
    ],
    "shortDescription": "Isolated Speechify Tauri comparison candidate",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "libasound2t64",
          "xclip",
          "xdotool"
        ]
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
